# Copy this file to server/.env and fill in what you need. Everything is optional.

PORT=3000

# Password for the usage page (/stats). If empty, a random one is printed when the server starts.
ADMIN_PASSWORD=

# Signs the login cookie. Set any long random text so logins survive restarts.
# SESSION_SECRET=

# How long a QR code stays valid before a fresh one appears (seconds)
ROOM_TTL_SECONDS=300

# Address phones should open. Leave empty locally; set it to your Render URL when deployed.
# PUBLIC_URL=https://beam-p2p.onrender.com

# Local HTTPS with a self-signed certificate (only needed for testing on Wi-Fi)
# HTTPS=true

# MySQL for session logs. Without DB_HOST, logs are kept in memory.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=beam
# DB_SSL=false

# Optional TURN relay for networks that block direct connections (for example Metered free tier)
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
